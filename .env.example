# Local backend persistence. If omitted, SQLite is used automatically.
DATABASE_URL=sqlite:///./edgeops.db

# Frontend development. Vite already proxies /api to localhost:8000.
VITE_API_BASE_URL=/api

# Docker Compose overrides DATABASE_URL automatically and uses PostgreSQL.

# Optional API authentication. Set true and use strong unique secrets before exposing publicly.
EDGEOPS_AUTH_ENABLED=false
EDGEOPS_ADMIN_USERNAME=admin
EDGEOPS_ADMIN_PASSWORD=replace-with-a-long-random-password
EDGEOPS_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
